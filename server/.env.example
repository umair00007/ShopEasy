# Copy this file to .env and fill in real values:  cp .env.example .env
# .env is git-ignored. NEVER commit real secrets.

NODE_ENV=development
PORT=5001
CLIENT_URL=http://localhost:5173

# MongoDB Atlas → Database → Connect → Drivers. Put the DB name (shopeasy) before the "?".
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/shopeasy?retryWrites=true&w=majority

# ---- Added in later phases ----
JWT_SECRET=change-me-to-a-long-random-string   # generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_EXPIRES_IN=7d
# ---- AWS S3 (Phase 3) ----
AWS_REGION=ap-south-1
AWS_S3_BUCKET=
# Local dev ONLY. On EC2 leave these two EMPTY and attach an IAM Role instead (Phase 7).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# ---- Razorpay TEST mode (Phase 5): Dashboard → Settings → API Keys → Generate Test Key ----
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=

# ---- Password-reset email (optional in dev: if SMTP_HOST is empty the link prints in the server console) ----
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com, SMTP_PASS=<16-char App Password>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Shabbir Traders <no-reply@example.com>
